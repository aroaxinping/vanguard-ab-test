    <worksheet name='Client Completion Rate'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontname='Tableau Medium'>Client Completion Rate</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='client_kpis' name='federated.1vtrvqw0pw5ub0174564i0vwjtc3' />
          </datasources>
          <datasource-dependencies datasource='federated.1vtrvqw0pw5ub0174564i0vwjtc3'>
            <column caption='Client Completion Rate' datatype='real' default-format='p0.00%' name='[Calculation_1311205996597250]' role='measure' type='quantitative'>
