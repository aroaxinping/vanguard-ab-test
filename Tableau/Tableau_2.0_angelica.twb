    <worksheet name='Cumulative Completion Journey'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Cumulative Completion Journey</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>As time passes, how quickly does each group </run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>accumulate successful completions?</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='client_kpis' name='federated.1vtrvqw0pw5ub0174564i0vwjtc3' />
          </datasources>
          <datasource-dependencies datasource='federated.1vtrvqw0pw5ub0174564i0vwjtc3'>
            <column caption='Completion Time Min' datatype='real' name='[Calculation_0177884638044162]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[completion_time_s] / 60.0' />
            </column>
            <column caption='Completed Client' datatype='integer' name='[Calculation_0177884639191044]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [completed] = TRUE THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
            </column>
            <column caption='Clients in Group' datatype='integer' name='[Calculation_0177884639473669]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [group] : COUNTD([client_id]) }' />
            </column>
            <column caption='Cumulative Completation Rate' datatype='real' default-format='p0.00%' name='[Calculation_0177884639895558]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM(SUM([Calculation_0177884639191044]))&#13;&#10;/&#13;&#10;MIN([Calculation_0177884639473669])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Completion Time Bin' datatype='integer' name='[Completion Time Min (bin)]' role='dimension' type='ordinal'>
              <calculation class='bin' decimals='-1' formula='[Calculation_0177884638044162]' peg='0' size='0.5' />
            </column>
            <column caption='Client Id' datatype='integer' name='[client_id]' role='dimension' type='ordinal' />
            <column caption='Completed' datatype='boolean' name='[completed]' role='dimension' type='nominal' />
            <column caption='Completion Time S' datatype='real' datatype-customized='true' name='[completion_time_s]' role='dimension' type='ordinal' />
            <column caption='Group' datatype='string' name='[group]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_0177884638044162]' derivation='None' name='[none:Calculation_0177884638044162:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Completion Time Min (bin)]' derivation='None' name='[none:Completion Time Min (bin):qk]' pivot='key' type='quantitative' />
            <column-instance column='[group]' derivation='None' name='[none:group:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0177884639895558]' derivation='User' name='[usr:Calculation_0177884639895558:qk:2]' pivot='key' type='quantitative'>
              <table-calc ordering-field='[federated.1vtrvqw0pw5ub0174564i0vwjtc3].[Completion Time Min (bin)]' ordering-type='Field' />
            </column-instance>
          </datasource-dependencies>
          <filter class='quantitative' column='[federated.1vtrvqw0pw5ub0174564i0vwjtc3].[none:Calculation_0177884638044162:qk]' included-values='in-range'>
            <min>0.0</min>
            <max>30.0</max>
          </filter>
          <slices>
            <column>[federated.1vtrvqw0pw5ub0174564i0vwjtc3].[none:Calculation_0177884638044162:qk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
