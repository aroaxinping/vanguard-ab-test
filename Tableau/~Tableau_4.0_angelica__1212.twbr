      <column caption='Cumulative Median Minutes' datatype='real' name='[Calculation_0529453558689796]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(MIN([median_seconds])) / 60.0'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Relative Transition Frequency' datatype='real' name='[Calculation_0529453563777032]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([observations])&#13;&#10;/&#13;&#10;LOOKUP(SUM([observations]), FIRST())'>
